# .gitignore for Hybrid IDS SIEM

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv

# Jupyter Notebook
.ipynb_checkpoints

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# ===== DATA DIRECTORIES =====
# Ignore large real datasets and processed data
data/raw/
data/processed/

# Allow mock data (for instant testing after clone)
!data/mock/
!data/mock/**

# Keep directory structure
!data/.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep

# ===== MODELS DIRECTORY =====
# Ignore all trained models (large files)
models/
# But keep directory structure
!models/.gitkeep
!models/nids/
!models/nids/.gitkeep
!models/hids/
!models/hids/.gitkeep

# Explicitly ignore model files
*.pkl
*.h5
*.joblib
*.pt
*.pth

# Logs
*.log
logs/
*.out

# Temporary files
*.tmp
*.temp
.cache/

# Dashboard cache
dashboard/.streamlit/
.dash_cache/

# Dataset archives
*.zip
*.tar.gz
*.tgz
*.tar
*.pcap
*.pcapng
